# Steam account that owns Arma 3.
# REQUIRED — anonymous install of app 233780 is rejected by Steam.
# Copy to `.env` (which is gitignored) and fill in.
STEAM_USER=
STEAM_PASSWORD=

# Antistasi release tag (e.g. "3.11.1") or "latest". Default: latest.
# ANTISTASI_VERSION=latest

# ---- server.cfg template values ----
SERVER_HOSTNAME=Antistasi Dedicated
SERVER_PASSWORD=                # empty = public server
ADMIN_PASSWORD=changeme         # in-game `#login <pwd>` to gain admin
MAX_PLAYERS=20
MISSION_TEMPLATE=Antistasi_Altis.Altis
MISSION_DIFFICULTY=Regular

# Diagnostic / security knobs. Defaults are correct for production use.
# BATTLEYE_ENABLE=1            # set to 0 to disable BattlEye
# VERIFY_SIGNATURES=2          # set to 0 to disable mod-signature enforcement
